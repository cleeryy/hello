# Required: MAC woken by GET /wake.
DEFAULT_MAC=00:11:22:33:44:55
# Optional: listen port (default 8080).
PORT=8080
# Optional: subnet broadcast for magic packets (default 255.255.255.255).
BROADCAST_IP=192.168.1.255
# Optional: device registry file (default devices.json).
DEVICES_FILE=devices.json
# Optional: status poll interval in seconds (default 30).
MONITOR_INTERVAL_SEC=30
# Optional: bearer token locking the API (unset = open mode, local-dev only).
API_TOKEN=change-me
